{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Permissions for the main Échéancier window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:app:default",
    "core:path:default",
    "core:event:default",
    "dialog:default",
    "dialog:allow-open",
    "os:default",
    "os:allow-locale",
    "fs:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPDATA/**" }, { "path": "$APPLOCALDATA/**" }]
    }
  ]
}
