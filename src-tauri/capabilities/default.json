{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Permissions for the main paymentSchedule window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:app:default",
    "core:path:default",
    "core:event:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "os:default",
    "os:allow-locale",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "tel:*" }, { "url": "sms:*" }]
    }
  ]
}
